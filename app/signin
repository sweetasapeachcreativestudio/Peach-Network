                  <h1 className="pn-form-title">Apply to Join the Network</h1>
                  <p className="pn-form-sub">Submit your portfolio to get vetted by our Creative Mentors.</p>
                </>
              )
            )}
          </div>

          {/* Creative Onboarding Process Callout */}
          {persona === "creative" && authMode === "signup" && (
            <div className="pn-creative-process-banner">
              <div className="pn-cp-title">
                <span>⏱</span> Application Takes ~3 Minutes • The Vetting Process:
              </div>
              <ul className="pn-cp-steps">
                <li><strong>1. Submit Portfolio:</strong> Share your links, best work, and design specialties.</li>
                <li><strong>2. Mentor Review:</strong> Reviewed within 24–48 hours by our Senior Art Directors.</li>
                <li><strong>3. Placement:</strong> Placed on the 3-Tier Ladder (Rising, Pro, or Senior Mentor).</li>
              </ul>
            </div>
          )}

          {/* One-Click Google Authentication */}
          <button type="button" className="pn-google-btn" onClick={handleGoogleSignIn}>
            <svg width="20" height="20" viewBox="0 0 24 24">
              <path
                fill="#4285F4"
                d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.8-2.4 3.66v3.05h3.88c2.27-2.09 3.665-5.17 3.665-9.15z"
              />
              <path
                fill="#34A853"
                d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.24v3.15C3.26 21.36 7.33 24 12 24z"
              />
              <path
                fill="#FBBC05"
                d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.24C.45 8.16 0 9.98 0 12s.45 3.84 1.24 5.42l4.04-3.15z"
              />
              <path
                fill="#EA4335"
                d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.33 0 3.26 2.64 1.24 6.58l4.04 3.15c.95-2.83 3.6-4.98 6.72-4.98z"
              />
            </svg>
            <span>{authMode === "signup" ? "Sign Up with Google" : "Continue with Google"}</span>
          </button>

          <div className="pn-auth-divider">Or with email</div>

          {/* Form */}
          <form className="pn-auth-form" onSubmit={handleSignIn}>
            {authMode === "signup" && (
              <div className="pn-input-group">
                <label className="pn-label">Full Name</label>
                <input
                  type="text"
                  required
                  placeholder="e.g. Sarah Jenkins"
                  className="pn-input"
                  value={fullName}
                  onChange={(e) => setFullName(e.target.value)}
                />
              </div>
            )}

            {authMode === "signup" && persona === "partner" && (
              <div className="pn-input-group">
                <label className="pn-label">Business or Organization Name</label>
                <input
                  type="text"
                  required
                  placeholder="e.g. New Joy Church or Red Mountain BBQ"
                  className="pn-input"
                  value={businessName}
                  onChange={(e) => setBusinessName(e.target.value)}
                />
              </div>
            )}

            {authMode === "signup" && persona === "creative" && (
              <>
                <div className="pn-input-group">
                  <label className="pn-label">Portfolio URL / Behance / Instagram</label>
                  <input
                    type="url"
                    required
                    placeholder="https://behance.net/yourprofile or yoursite.com"
                    className="pn-input"
                    value={portfolioUrl}
                    onChange={(e) => setPortfolioUrl(e.target.value)}
                  />
                </div>
                <div className="pn-input-group">
                  <label className="pn-label">Primary Creative Specialty</label>
                  <select
                    className="pn-select"
                    value={specialty}
                    onChange={(e) => setSpecialty(e.target.value)}
                  >
                    <option value="graphic_design">Graphic & Event Flyer Design</option>
                    <option value="illustration">Brand Identity & Illustration</option>
                    <option value="video_editing">Video Editing & Motion Graphics</option>
                    <option value="web_ui">Web & Storefront UI Design</option>
                  </select>
                </div>
              </>
            )}

            <div className="pn-input-group">
              <label className="pn-label">Email Address</label>
              <input
                type="email"
                required
                placeholder="name@company.com"
                className="pn-input"
                value={email}
                onChange={(e) => setEmail(e.target.value)}
              />
            </div>

            <div className="pn-input-group">
              <label className="pn-label">Password</label>
              <input
                type="password"
                required
                placeholder="••••••••"
                className="pn-input"
                value={password}
                onChange={(e) => setPassword(e.target.value)}
              />
            </div>

            <button type="submit" className="pn-submit-btn">
              {persona === "partner"
                ? authMode === "login"
                  ? "Sign In as Peach Partner"
                  : "Complete 60-Second Signup"
                : authMode === "login"
                ? "Sign In as Peach Creative"
                : "Submit Creative Application"}
            </button>
          </form>

          {/* Toggle between Login and Signup */}
          <div className="pn-switch-mode-bar">
            {authMode === "login" ? (
              <span>
                First time here?{" "}
                <button
                  type="button"
                  className="pn-switch-link"
                  onClick={() => setAuthMode("signup")}
                >
                  {persona === "partner" ? "Sign up now (60 seconds)" : "Apply to join the network"}
                </button>
              </span>
            ) : (
              <span>
                Already have an account?{" "}
                <button
                  type="button"
                  className="pn-switch-link"
                  onClick={() => setAuthMode("login")}
                >
                  Sign in here
                </button>
              </span>
            )}
          </div>

          {/* Status feedback */}
          {authSuccess && (
            <div className="pn-success-banner">
              ✓ {authSuccess}
            </div>
          )}
        </div>
      </div>

      {/* LOW COIN BALANCE (< 5 COINS) & MEMBERSHIP ONBOARDING POPUP */}
      {showLowCoinModal && (
        <div className="pn-modal-backdrop">
          <div className="pn-modal-dialog">
            <div className="pn-modal-header">
              <div className="pn-modal-icon">🪙</div>
              <div>
                <h3 className="pn-modal-title">Hey Peach Partner, your coins are getting low!</h3>
                <span style={{ fontSize: "12px", color: "#E85D3F", fontWeight: 800 }}>
                  Current Balance: {coinBalance} Peach Coins remaining
                </span>
              </div>
            </div>

            <p className="pn-modal-body">
              Want to keep your projects moving without delay? Start a <strong>Monthly Membership</strong> to unlock bonus coins and rollover banking, or grab an à la carte top-up.
            </p>

            {/* Two Choices */}
            <div className="pn-modal-options-grid">
              {/* Option 1: Monthly Membership */}
              <div className="pn-m-option" style={{ border: "2px solid #E85D3F" }}>
                <div>
                  <div className="pn-mo-title">Monthly Membership</div>
                  <div className="pn-mo-price">From $499 / mo (10 Coins)</div>
                  <p className="pn-mo-desc">
                    ✓ Save up to 20% on deliverables<br />
                    ✓ Unused coins roll over automatically<br />
                    ✓ Fast 24–48h priority draft queue
                  </p>
                </div>
                <button
                  type="button"
                  className="pn-mo-btn pn-mo-btn-peach"
                  onClick={() => {
                    setShowLowCoinModal(false);
                    setAuthSuccess("Redirecting to Monthly Membership Plans...");
                  }}
                >
                  Explore Memberships
                </button>
              </div>

              {/* Option 2: À La Carte Top Up */}
              <div className="pn-m-option">
                <div>
                  <div className="pn-mo-title">À La Carte Top-Up</div>
                  <div className="pn-mo-price">From $50 / Coin</div>
                  <p className="pn-mo-desc">
                    ✓ Pay only for what you need today<br />
                    ✓ Instant coin deposit into your vault<br />
                    ✓ No monthly commitment
                  </p>
                </div>
                <button
                  type="button"
                  className="pn-mo-btn pn-mo-btn-outline"
                  onClick={() => {
                    setShowLowCoinModal(false);
                    setAuthSuccess("Opening Coin Top-Up Cashier...");
                  }}
                >
                  Top Up Coins
                </button>
              </div>
            </div>

            {/* Opt-out notification checkbox */}
            <div className="pn-opt-out-row">
              <input
                type="checkbox"
                id="dontNotifyAgainCheckbox"
                className="pn-checkbox"
                checked={dontNotifyAgain}
                onChange={(e) => setDontNotifyAgain(e.target.checked)}
              />
              <label htmlFor="dontNotifyAgainCheckbox" className="pn-opt-out-label">
                <strong>Don&apos;t show this notification again</strong>
                <span className="pn-opt-out-hint">
                  You can re-enable low coin balance alerts anytime in your Account Settings.
                </span>
              </label>
            </div>

            <button
              type="button"
              className="pn-modal-dismiss-btn"
              onClick={() => {
                setShowLowCoinModal(false);
                setNotificationDismissed(true);
                setAuthSuccess("Welcome back, Peach Partner! Loading dashboard...");
              }}
            >
              Continue to Dashboard for now
            </button>
          </div>
        </div>
      )}
    </div>
  );
}
